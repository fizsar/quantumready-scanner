[Unit]
Description=QuantumReady: monthly restore drill of the latest backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=debian
Group=debian
WorkingDirectory=/opt/quantumready
EnvironmentFile=/opt/quantumready/backup.env
ExecStart=/usr/bin/bash /opt/quantumready/bin/restore-test.sh
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
