[Unit]
Description=QuantumReady: daily PostgreSQL backup (restic, Backblaze B2)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=debian
Group=debian
WorkingDirectory=/opt/quantumready
# root:root 0600: systemd reads it before dropping privileges.
EnvironmentFile=/opt/quantumready/backup.env
ExecStart=/usr/bin/bash /opt/quantumready/bin/backup.sh
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
