# /opt/quantumready/backup.env (root:root, 0600). Read by qr-backup.service and
# qr-restore-test.service. Never commit the real file.

# Bucket "Endpoint" in Backblaze (Buckets → bucket details), then /bucket-name.
RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/fizsar-qr-backups
AWS_DEFAULT_REGION=eu-central-003

# Encryption password of the restic repository. Without it the backups cannot
# be read: keep it in the password manager AND an offline copy as well.
RESTIC_PASSWORD=

# Backblaze application key restricted to the bucket, without deleteFiles:
# keyID and applicationKey.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Healthchecks.io ping URLs (https://hc-ping.com/<uuid>), one check each.
HC_PING_URL=
HC_RESTORE_PING_URL=
