# Site block appended to the VPS Caddyfile (/srv/caddy/conf/Caddyfile).
# Caddy runs in a container on the shared `web` network and reaches the stack
# by its network aliases. It terminates TLS, compresses and adds HSTS; the web
# container sets CSP and the other page headers.
quantumready.fizsar.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle /api/* {
		reverse_proxy quantumready-api:8080
	}
	handle {
		reverse_proxy quantumready-web:8080
	}
}
