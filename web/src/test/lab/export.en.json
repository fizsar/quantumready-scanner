    "findings": [
      {
        "code": "KEX_NO_HYBRID",
        "axis": "quantum",
        "axis_label": "Quantum risk",
        "severity": "critical",
        "severity_label": "Critical",
        "category": "key_exchange",
        "title": "No post-quantum key exchange",
        "detail": "The server accepts no hybrid ML-KEM group. Key exchange is classical only (ECDHE or RSA), which a quantum computer will be able to break with Shor's algorithm: traffic captured today could be decrypted in the future (\"harvest now, decrypt later\"). This is the most urgent quantum risk because it affects data already in transit.",
        "remediation": "Enable the hybrid group X25519MLKEM768 in TLS 1.3: OpenSSL 3.5+, BoringSSL, Go 1.24+, Caddy 2.10+, nginx built with OpenSSL 3.5, or your CDN or load balancer's post-quantum option. Keep X25519 as a fallback for older clients."
      },
      {
        "code": "DH_WEAK",
        "axis": "current",
        "axis_label": "Current risk",
        "severity": "critical",
        "severity_label": "Critical",
        "category": "key_exchange",
        "title": "Diffie-Hellman far too weak (512 bits)",
        "detail": "The DHE suites use a group under 1024 bits. The Logjam attack (CVE-2015-4000) can break it in real time and decrypt or tamper with the connection.",
        "remediation": "Configure a DH group of 2048 bits or more (e.g. ffdhe2048 or ffdhe3072, RFC 7919), or drop the DHE suites and keep ECDHE only."
      },
      {
        "code": "SUITE_ANON",
        "axis": "current",
        "axis_label": "Current risk",
        "severity": "critical",
        "severity_label": "Critical",
        "category": "cipher_suites",
        "title": "Anonymous suites accepted (server not authenticated)",
        "detail": "With these suites the server does not prove its identity: there is no certificate. Anyone on the network can impersonate it and read or change the traffic (man in the middle). Suites: TLS_DH_anon_WITH_RC4_128_MD5, TLS_DH_anon_WITH_DES_CBC_SHA, TLS_DH_anon_WITH_3DES_EDE_CBC_SHA, TLS_DH_anon_WITH_AES_128_CBC_SHA, TLS_DH_anon_WITH_AES_256_CBC_SHA, TLS_DH_anon_WITH_CAMELLIA_128_CBC_SHA, TLS_DH_anon_WITH_AES_128_CBC_SHA256, TLS_DH_anon_WITH_AES_256_CBC_SHA256, TLS_DH_anon_WITH_CAMELLIA_256_CBC_SHA, TLS_DH_anon_WITH_SEED_CBC_SHA, TLS_DH_anon_WITH_AES_128_GCM_SHA256, TLS_DH_anon_WITH_AES_256_GCM_SHA384, TLS_ECDH_anon_WITH_RC4_128_SHA, TLS_ECDH_anon_WITH_3DES_EDE_CBC_SHA, TLS_ECDH_anon_WITH_AES_128_CBC_SHA, TLS_ECDH_anon_WITH_AES_256_CBC_SHA.",
        "remediation": "Remove them (in OpenSSL, \"!aNULL\")."
      },
      {
        "code": "SUITE_DES",
        "axis": "current",
        "axis_label": "Current risk",
        "severity": "critical",
        "severity_label": "Critical",
        "category": "cipher_suites",
        "title": "DES cipher (56-bit) accepted",
        "detail": "Single DES uses 56-bit keys, which have been brute-forced since 1998. Suites: TLS_RSA_WITH_DES_CBC_SHA, TLS_DHE_RSA_WITH_DES_CBC_SHA.",
        "remediation": "Remove the DES suites (in OpenSSL, \"!DES:!LOW\") and use AES-GCM or ChaCha20-Poly1305."
      },
      {
        "code": "SUITE_EXPORT",
        "axis": "current",
        "axis_label": "Current risk",
        "severity": "critical",
        "severity_label": "Critical",
        "category": "cipher_suites",
        "title": "EXPORT suites accepted",
        "detail": "EXPORT suites use 40 or 56-bit keys, deliberately weakened in the 1990s by US export rules. Today they break in minutes and enable the FREAK (CVE-2015-0204) and Logjam (CVE-2015-4000) attacks. Suites: TLS_RSA_EXPORT_WITH_RC4_40_MD5, TLS_RSA_EXPORT_WITH_RC2_CBC_40_MD5, TLS_RSA_EXPORT_WITH_DES40_CBC_SHA, TLS_DHE_RSA_EXPORT_WITH_DES40_CBC_SHA, TLS_DH_anon_EXPORT_WITH_RC4_40_MD5, TLS_DH_anon_EXPORT_WITH_DES40_CBC_SHA.",
        "remediation": "Remove them (in OpenSSL, \"!EXPORT\") or upgrade the software: current releases no longer include them."
      },
      {
        "code": "SUITE_NULL",
        "axis": "current",
        "axis_label": "Current risk",
        "severity": "critical",
        "severity_label": "Critical",
        "category": "cipher_suites",
        "title": "Unencrypted connections accepted (NULL suites)",
        "detail": "The server accepts suites that encrypt nothing: whatever travels over them can be read as is. An attacker on the network can force them if the client allows them. Suites: TLS_RSA_WITH_NULL_MD5, TLS_RSA_WITH_NULL_SHA, TLS_RSA_WITH_NULL_SHA256, TLS_ECDHE_RSA_WITH_NULL_SHA, TLS_ECDH_anon_WITH_NULL_SHA.",
        "remediation": "Remove the NULL suites from the configuration (in OpenSSL, add \"!eNULL\" to the cipher list)."
      },
      {
        "code": "TLS13_MISSING",
        "axis": "quantum",
        "axis_label": "Quantum risk",
        "severity": "high",
        "severity_label": "High",
        "category": "protocol",
        "title": "Without TLS 1.3, hybrid ML-KEM key exchange cannot be adopted",
        "detail": "The server only accepts versions older than TLS 1.3. That may be secure today, but hybrid ML-KEM groups only exist in TLS 1.3: until it is enabled, traffic stays exposed to \"harvest now, decrypt later\" and no group configuration can fix it.",
        "remediation": "Enable TLS 1.3 (any server with OpenSSL 1.1.1 or later supports it, as do all current browsers), then the X25519MLKEM768 group. Keep TLS 1.2 for older clients."
      },
      {
        "code": "FS_PARTIAL",
        "axis": "current",
        "axis_label": "Current risk",
        "severity": "medium",
        "severity_label": "Medium",
        "category": "cipher_suites",
        "title": "Suites without forward secrecy",
        "detail": "Suites without an ephemeral key exchange, with RSA or static DH, are accepted (TLS_RSA_WITH_NULL_MD5, TLS_RSA_WITH_NULL_SHA, TLS_RSA_EXPORT_WITH_RC4_40_MD5, TLS_RSA_EXPORT_WITH_RC2_CBC_40_MD5, TLS_RSA_EXPORT_WITH_DES40_CBC_SHA, TLS_RSA_WITH_DES_CBC_SHA, TLS_RSA_WITH_NULL_SHA256). Whoever obtains the server's private key could decrypt traffic captured with them.",
        "remediation": "Remove the TLS_RSA_WITH_* suites and keep only ECDHE ones."
      },
      {
        "code": "PROTO_LEGACY_TLS",
        "axis": "current",
        "axis_label": "Current risk",
        "severity": "medium",
        "severity_label": "Medium",
        "category": "protocol",
        "title": "Obsolete versions enabled: TLS 1.0, TLS 1.1",
        "detail": "TLS 1.0 and 1.1 are deprecated (RFC 8996): they only allow weak constructions and browsers no longer use them. Keeping them enabled widens the attack surface for no benefit.",
        "remediation": "Disable TLS 1.0 and 1.1 and keep only TLS 1.2 and 1.3."
      },
      {
        "code": "CERT_CLASSICAL_SIGNATURE",
        "axis": "quantum",
        "axis_label": "Quantum risk",
        "severity": "low",
        "severity_label": "Low",
        "category": "certificate",
        "title": "Classical signature (RSA-2048): future quantum risk",
        "detail": "The server proves its identity with RSA-2048, which a quantum computer will be able to forge. This is not \"harvest now, decrypt later\": a signature only has to hold during the handshake, so the risk starts the day such a computer exists, not before. There are no post-quantum (ML-DSA) certificates on the public web yet. It does not affect the grade.",
        "remediation": "Nothing to do on the signature yet. Automate renewal (ACME) so you can switch to post-quantum (ML-DSA or hybrid) certificates as soon as authorities issue them: today this certificate shows no sign of renewing itself."
      },
