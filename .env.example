# Copy to .env and adjust. Never commit .env. `make dev` creates it from this file if missing.
# The values below are for local development only.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=quantumready
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=quantumready
# Host port, always bound to 127.0.0.1.
POSTGRES_PORT=5432

# --- API ---
# Listen address. Keep it on loopback: Caddy is the only public entry point.
API_ADDR=127.0.0.1:8080
# PostgreSQL connection string for the API and worker (must match the values above).
DATABASE_URL=postgres://quantumready:change-me-local-only@127.0.0.1:5432/quantumready?sslmode=disable
