# Copy to .env and adjust. Never commit .env. `make dev` creates it from this file if missing.
# The values below are for local development only.

# --- PostgreSQL (dev compose.yaml and deploy/compose.prod.yaml) ---
POSTGRES_USER=quantumready
# Must be URL-safe: compose.prod.yaml builds DATABASE_URL from it.
# In production generate it with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=quantumready
# Dev only: host port, always bound to 127.0.0.1.
POSTGRES_PORT=5432

# --- API (dev only: compose.prod.yaml sets its own API_ADDR and DATABASE_URL) ---
# Listen address. Keep it on loopback: Caddy is the only public entry point.
API_ADDR=127.0.0.1:8080
# PostgreSQL connection string for the API, worker and migrate (must match the values above).
DATABASE_URL=postgres://quantumready:change-me-local-only@127.0.0.1:5432/quantumready?sslmode=disable

# --- Production images (optional; `make prod-up` sets them from git) ---
# QR_VERSION=v0.1.0
# QR_COMMIT=abc1234
