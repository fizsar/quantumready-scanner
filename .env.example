# Copy to .env and adjust. Never commit .env. `make dev` creates it from this file if missing.
# The values below are for local development only.

# --- PostgreSQL (dev compose.yaml and deploy/compose.prod.yaml) ---
POSTGRES_USER=quantumready
# Must be URL-safe: compose.prod.yaml builds DATABASE_URL from it.
# In production generate it with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=quantumready
# Dev only: host port, always bound to 127.0.0.1.
POSTGRES_PORT=5432

# --- API and worker (dev only: compose.prod.yaml sets its own API_ADDR and DATABASE_URL) ---
# Listen address. Keep it on loopback: Caddy is the only public entry point.
API_ADDR=127.0.0.1:8080
# PostgreSQL connection string for the API, worker and migrate (must match the values above).
# sslmode=disable is required by the worker (see cmd/worker).
DATABASE_URL=postgres://quantumready:change-me-local-only@127.0.0.1:5432/quantumready?sslmode=disable

# --- Scans (dev and production) ---
# Exact hosts that may be scanned in this phase (comma-separated); anything else gets 403.
SCAN_ALLOWLIST=fizsar.com,quantumready.fizsar.com
# Scans in parallel per worker (1-32).
WORKER_CONCURRENCY=2
# Scans started per minute by all workers together (1-600; default 20).
WORKER_MAX_SCANS_PER_MINUTE=20
# Scan request limits. Per client IP (IPv6 per /64), in memory: per minute
# (1-1000) and per day (>= per minute). Within the cooldown (Go duration, 1s-24h)
# a request for the same target returns the latest scan and does not count.
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=30
SCAN_TARGET_COOLDOWN=2m
# Proxies whose X-Forwarded-For the API believes (CIDRs or IPs, comma-separated).
# Dev: empty. Production: compose sets it from QR_TRUSTED_PROXIES (the Caddy `web`
# network subnet), filled in by deploy.sh and `make prod-up`.
# TRUSTED_PROXIES=

# --- Public scanning (API) ---
# true: anyone can scan any domain (basic intensity) with a proof of work;
# false (default): only SCAN_ALLOWLIST. Opened after the security review.
PUBLIC_SCAN_OPEN=false
# Proof-of-work (ALTCHA) HMAC key, required when PUBLIC_SCAN_OPEN=true:
# openssl rand -hex 32 (in production, generated on the VPS).
# ALTCHA_HMAC_KEY=

# --- Accounts (API) ---
# Origin of the site (scheme://host[:port]): links in emails, and browsers'
# state-changing requests must come from it. https, except http://localhost.
# Empty disables /api/auth. Dev: Vite's origin. Production: https://quantumready.fizsar.com
PUBLIC_ORIGIN=http://localhost:5173
# Closed beta: accounts created by invitation cannot create organizations of
# their own. Set to true when opening.
BETA_INVITED_CAN_CREATE_ORGS=false
# Address shown in emails for questions (default soporte@fizsar.com).
# MAIL_SUPPORT=soporte@fizsar.com

# --- Mailer (cmd/mailer: sends the queued emails) ---
# Dev: Mailpit from compose.yaml (http://127.0.0.1:8025), no TLS, no credentials.
# Production: Scaleway TEM, SMTP_HOST=smtp.tem.scaleway.com, SMTP_PORT=587,
# SMTP_SECURITY=starttls and the TEM credentials (generated on the VPS, never here).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# starttls | tls | none (none only for a local catcher, and refuses credentials)
SMTP_SECURITY=none
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Quoted: the Makefile sources this file with the shell.
MAIL_FROM="QuantumReady <no-reply@quantumready.fizsar.com>"
MAIL_REPLY_TO=soporte@fizsar.com

# --- Production (deploy/compose.prod.yaml) ---
# Image tag to run from GHCR: sha-<commit> (preferred) or latest.
# deploy/deploy.sh sets it on the VPS; `make prod-up` sets it from git locally.
# QR_TAG=sha-14226c7
# QR_TRUSTED_PROXIES=172.18.0.0/16
